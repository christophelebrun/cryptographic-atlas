{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptographic-atlas.local/schemas/labels.schema.json",
  "title": "Cryptographic Atlas reader-facing labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_locale", "locales", "namespaces"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "default_locale": {"type": "string", "minLength": 2},
    "locales": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "minItems": 1,
      "uniqueItems": true
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labels"],
          "properties": {
            "labels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "aliases": {
              "type": "array",
              "items": {"type": ["string", "number", "boolean"]},
              "uniqueItems": true
            },
            "description": {"type": "string"}
          }
        }
      }
    }
  }
}
