{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptographic-atlas.local/schemas/source-freshness.schema.json",
  "title": "Cryptographic Atlas source freshness clusters",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "review_window_months",
          "last_reviewed",
          "next_review_due",
          "topics",
          "reference_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "review_window_months": {"type": "integer", "minimum": 1, "maximum": 36},
          "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "next_review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "topics": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "reference_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
