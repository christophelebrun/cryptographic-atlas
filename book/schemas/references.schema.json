{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptographic-atlas.local/schemas/references.schema.json",
  "title": "Cryptographic Atlas references",
  "type": "object",
  "additionalProperties": false,
  "required": ["references"],
  "properties": {
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "authors", "year", "source_type", "url", "used_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "authors": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "year": {"type": ["integer", "string"]},
          "source_type": {
            "type": "string",
            "enum": ["paper", "preprint", "textbook", "standard", "official-docs", "survey", "engineering-blog"]
          },
          "url": {"type": "string", "minLength": 1},
          "doi": {"type": "string"},
          "notes": {"type": "string"},
          "used_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        }
      }
    }
  }
}
