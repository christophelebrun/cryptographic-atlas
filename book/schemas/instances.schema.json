{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptographic-atlas.local/schemas/instances.schema.json",
  "title": "Cryptographic Atlas concrete instances",
  "type": "object",
  "additionalProperties": false,
  "required": ["instances"],
  "properties": {
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "instance_of",
          "taxonomy_level",
          "maturity",
          "post_quantum_posture",
          "assumptions",
          "common_uses",
          "cautions",
          "references"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": [
              "algorithm",
              "construction",
              "curve",
              "encoding",
              "mode",
              "parameter-family",
              "protocol-suite",
              "scheme",
              "standard"
            ]
          },
          "instance_of": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "minItems": 1,
            "uniqueItems": true
          },
          "taxonomy_level": {
            "type": "string",
            "enum": [
              "mathematical-assumption",
              "basic-primitive",
              "structured-primitive",
              "proof-system",
              "protocol",
              "system",
              "design-pattern"
            ]
          },
          "maturity": {
            "type": "string",
            "enum": ["deployed", "mature", "emerging", "research", "theoretical"]
          },
          "post_quantum_posture": {
            "type": "string",
            "enum": ["vulnerable", "plausible", "depends", "unknown", "not-applicable"]
          },
          "requires_trusted_setup": {
            "anyOf": [
              {"type": "boolean"},
              {"type": "string", "enum": ["depends", "varies", "not-applicable"]}
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "common_uses": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "cautions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "references": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
